local p4fs = os.getenv("P4FS") or ""
local p4client = os.getenv("P4CLIENT") or ""
local base_path = p4fs .. "/" .. p4client

return {
    projws = {
        base_path .. "/dir1/dir2/",
        base_path .. "/dir1/dir3/dir4/"
    },
    skip = {
            -- Dla każdego katalogu podajemy dwie formy:
            "dirToSkip/**", "**/dirToSkip/**",
            "dirToSkip2/**", "**/dirToSkip2/**"
        }
}
